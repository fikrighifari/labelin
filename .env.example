# Optional public web application client ID for Google Sign-In.
# Add the deployed origin to the OAuth client's authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=

# Server-only PostgreSQL connection; never prefix this variable with VITE_.
DATABASE_URL=

# Optional exact HTTPS origins that serve this site's UI through a trusted proxy.
# Comma-separated; no wildcards, paths, or unrelated embedding sites.
LABELIN_ALLOWED_ORIGINS=
